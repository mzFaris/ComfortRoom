# ESP32 firmware toolchain for ComfortRoom.
#
# Contains arduino-cli, the ESP32 core and every library the sketch needs, so
# compiling and uploading only requires Podman plus a USB-attached board.
FROM docker.io/library/debian:bookworm-slim

ARG ARDUINO_CLI_VERSION=1.3.1

ENV DEBIAN_FRONTEND=noninteractive \
    ARDUINO_DIRECTORIES_DATA=/arduino/data \
    ARDUINO_DIRECTORIES_DOWNLOADS=/arduino/downloads \
    ARDUINO_DIRECTORIES_USER=/arduino/user

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl git xz-utils \
 && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://raw.githubusercontent.com/arduino/arduino-cli/master/install.sh \
      | BINDIR=/usr/local/bin sh -s "${ARDUINO_CLI_VERSION}"

# arduino-cli configuration. The ESP32 core itself is not baked in: it lives in
# the comfortroom-arduino-core Podman volume and is installed on first compile
# (see scripts/firmware.sh), which keeps this image small and makes image
# rebuilds cheap.
RUN mkdir -p /arduino/data \
 && arduino-cli config init --overwrite \
 && arduino-cli config set board_manager.additional_urls \
      https://raw.githubusercontent.com/espressif/arduino-esp32/gh-pages/package_esp32_index.json \
 && arduino-cli config set network.connection_timeout 10m

RUN arduino-cli lib install \
      "DHT sensor library" \
      PubSubClient \
      "Adafruit Unified Sensor" \
      ESP32_WiFi_Connect

# The Arduino-index ESPAsyncWebServer/AsyncTCP releases do not compile against
# ESP32 core 3.x (mbedtls_md5_*_ret removed). Replace them with the maintained
# ESP32Async forks, as documented in AGENTS.md.
RUN for lib in ESPAsyncWebServer AsyncTCP ESPAsyncTCP; do \
      arduino-cli lib uninstall "$lib" || true; \
    done \
 && rm -rf /arduino/user/libraries/ESPAsyncWebServer \
           /arduino/user/libraries/AsyncTCP \
           /arduino/user/libraries/ESPAsyncTCP \
 && git clone --depth 1 https://github.com/ESP32Async/AsyncTCP.git \
      /arduino/user/libraries/AsyncTCP \
 && git clone --depth 1 https://github.com/ESP32Async/ESPAsyncWebServer.git \
      /arduino/user/libraries/ESPAsyncWebServer

# The ESP32 core's build scripts need python3. Keep this in its own layer so
# adding it does not invalidate the large core download layer above.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["arduino-cli", "version"]
