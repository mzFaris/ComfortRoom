# Static ComfortRoom dashboard: build with Node, serve with nginx.
#
# Build context is the repository root (see scripts/dashboard.sh).
FROM docker.io/library/node:22-alpine AS build

WORKDIR /app

COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci

COPY dashboard/ .
RUN npm run build

FROM docker.io/library/nginx:alpine

COPY containers/dashboard/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
